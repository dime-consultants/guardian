# Environment Variables

# =============================================================================
# DEPLOYMENT & ALLOWED HOSTS
# =============================================================================
# Comma-separated list of allowed hosts for production
# Example: localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
# For development: localhost,127.0.0.1
# For production: your-domain.com,www.your-domain.com
#NEXT_PUBLIC_ALLOWED_HOSTS=kuehne.dimeconsultants.africa

# =============================================================================
# GROK AI INTEGRATION
# =============================================================================
# Get your API key from: https://console.x.ai/
# Used for AI chat functionality when backend is not connected
XAI_API_KEY=xai-HNVbUCYOMVSUgKjva2slRhg0N3mLTAp4b5y70Z3fI50iPYjNhu5pl0bDWKzriPQiJ0TEAHIgMCLWSi26

# =============================================================================
# BACKEND CONNECTION
# =============================================================================
# Django backend URL (set in Settings page or here)
# Example: http://localhost:8000 or https://your-backend.com
# NEXT_PUBLIC_BACKEND_URL=https://invoicing.dimeconsultants.africa,http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


# =============================================================================
# DEPLOYMENT & ALLOWED HOSTS
# =============================================================================
# Comma-separated list of allowed hosts for production
# Example: localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
# For development: localhost,127.0.0.1
# For production: your-domain.com,www.your-domain.com
NEXT_PUBLIC_ALLOWED_HOSTS=kuehne.dimeconsultants.africa
# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Token storage strategy:
#   - false (production): Access tokens stored in memory only + HTTP-only cookies
#   - true (development): Access tokens also stored in localStorage for easier debugging
# Default: false for security
NEXT_PUBLIC_USE_LOCALSTORAGE_TOKENS=false

# =============================================================================
# OPTIONAL: FEATURE FLAGS
# =============================================================================
# Enable demo mode by default (true/false)
NEXT_PUBLIC_DEFAULT_DEMO_MODE=false
